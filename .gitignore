# Spreadsheets (large, not needed for website)
*.xlsx

# Python
__pycache__/
*.pyc

# Backups & temp
backups/
old snapshots/
*.txt
elo_video_frames/
elo_test_frames/

# Regenerated build intermediate: elo_engine.py writes it, build_cups.py reads it
# in the same run. Not consumed by the deployed site, so it does not belong in git.
elo_results.json

# Raw lobby logs: irreplaceable source data (~110 MB, mostly cumulative livelogs), not needed by the site.
# Kept out of the public repo; backup_raw_data.py mirrors them off-drive at the end of new_cup.py.
cup logs/

# Machine-local backup destination for backup_raw_data.py (each operator creates their own)
backup_config.json
